# AURORA ELITE environment variables (set these in Vercel > Project > Settings > Environment Variables)
PORT=3000
APP_URL=https://aurora-elite-three.vercel.app
# Optional comma-separated extra origins allowed by CORS (e.g. http://localhost:3000 for dev)
ALLOWED_ORIGINS=

# Stripe (https://dashboard.stripe.com/apikeys and /webhooks)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# Admin login passphrase (min 12 chars, long and random)
ADMIN_MASTER_PASSPHRASE=
# HMAC secret used to sign admin and client session tokens (min 32 random chars)
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SIGNING_SECRET=

# Redis (Vercel Marketplace store — TCP URL). Required for durable orders/tokens in production.
# Example: rediss://default:TOKEN@HOST:PORT
REDIS_URL=
